{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile for riders and dispatch administrators.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "enum": ["rider", "admin"] },
        "phone": { "type": "string", "maxLength": 32 },
        "bikePlate": { "type": "string", "maxLength": 32 },
        "isOnline": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Explicit admin allowlist record.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "grantedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "grantedBy", "createdAt"]
    },
    "DeliveryOrder": {
      "title": "DeliveryOrder",
      "description": "Full delivery shipment order including PII and live GPS telemetry.",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "minLength": 4, "maxLength": 40, "pattern": "^[A-Z0-9-]+$" },
        "riderUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "riderName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "riderPhone": { "type": "string", "minLength": 4, "maxLength": 32 },
        "riderBike": { "type": "string", "minLength": 2, "maxLength": 32 },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "senderPhone": { "type": "string", "minLength": 4, "maxLength": 32 },
        "receiverName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "receiverPhone": { "type": "string", "minLength": 4, "maxLength": 32 },
        "packageType": { "type": "string", "maxLength": 40 },
        "packageNote": { "type": "string", "maxLength": 300 },
        "priority": { "type": "string", "enum": ["standard", "express"] },
        "fee": { "type": "number" },
        "destAddress": { "type": "string", "minLength": 1, "maxLength": 300 },
        "destPlaceId": { "type": "string", "maxLength": 256 },
        "destLat": { "type": "number" },
        "destLng": { "type": "number" },
        "startLat": { "type": "number" },
        "startLng": { "type": "number" },
        "deliveryCode": { "type": "string", "minLength": 4, "maxLength": 4, "pattern": "^[0-9]{4}$" },
        "status": { "type": "string", "enum": ["active", "delivered", "cancelled"] },
        "trackingState": { "type": "string", "enum": ["starting", "live", "stopped", "offline", "completed", "cancelled"] },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "heading": { "type": "number" },
        "speed": { "type": "number" },
        "accuracy": { "type": "number" },
        "isMoving": { "type": "boolean" },
        "routeDistanceMeters": { "type": "number" },
        "routeDurationSeconds": { "type": "number" },
        "sequence": { "type": "number" },
        "locationAt": { "type": "number" },
        "heartbeatAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastUpdated": { "type": "string", "format": "date-time" },
        "deliveredAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "orderId", "riderUid", "riderName", "riderPhone", "riderBike",
        "senderName", "senderPhone", "receiverName", "receiverPhone",
        "packageType", "priority", "fee", "destAddress", "destLat", "destLng",
        "startLat", "startLng", "deliveryCode", "status", "trackingState",
        "sequence", "createdAt", "lastUpdated"
      ]
    },
    "PublicTrackingSnapshot": {
      "title": "PublicTrackingSnapshot",
      "description": "Zero-PII real-time tracking snapshot for customer tracking view.",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "minLength": 4, "maxLength": 40, "pattern": "^[A-Z0-9-]+$" },
        "riderUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "riderDisplayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "riderBike": { "type": "string", "minLength": 2, "maxLength": 32 },
        "packageType": { "type": "string", "maxLength": 40 },
        "priority": { "type": "string", "enum": ["standard", "express"] },
        "destLabel": { "type": "string", "minLength": 1, "maxLength": 200 },
        "destLat": { "type": "number" },
        "destLng": { "type": "number" },
        "startLat": { "type": "number" },
        "startLng": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "delivered", "cancelled"] },
        "trackingState": { "type": "string", "enum": ["starting", "live", "stopped", "offline", "completed", "cancelled"] },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "heading": { "type": "number" },
        "speed": { "type": "number" },
        "accuracy": { "type": "number" },
        "isMoving": { "type": "boolean" },
        "routeDistanceMeters": { "type": "number" },
        "routeDurationSeconds": { "type": "number" },
        "sequence": { "type": "number" },
        "locationAt": { "type": "number" },
        "lastUpdated": { "type": "string", "format": "date-time" },
        "deliveredAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "orderId", "riderUid", "riderDisplayName", "riderBike",
        "packageType", "priority", "destLabel", "destLat", "destLng",
        "startLat", "startLng", "status", "trackingState", "sequence", "lastUpdated"
      ]
    },
    "OrderEvent": {
      "title": "OrderEvent",
      "description": "Milestone and movement telemetry audit event for an order.",
      "type": "object",
      "properties": {
        "eventId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "type": { "type": "string", "enum": ["created", "moving", "stopped", "destination_updated", "offline_synced", "delivered", "cancelled"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 200 },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["eventId", "type", "message", "actorUid", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Rider and admin user profiles with strict owner/admin PII isolation."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Explicit admin allowlist documents."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/DeliveryOrder" },
      "description": "Full delivery orders with customer/rider PII and real-time GPS state."
    },
    "/orders/{orderId}/events/{eventId}": {
      "schema": { "$ref": "#/entities/OrderEvent" },
      "description": "Real-time delivery timeline and motion audit events."
    },
    "/publicTracking/{orderId}": {
      "schema": { "$ref": "#/entities/PublicTrackingSnapshot" },
      "description": "PII-free live tracking mirror keyed by exact orderId."
    }
  }
}
